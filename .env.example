# ── PayPal credentials ────────────────────────────────────────────────────────
# From https://developer.paypal.com/dashboard/ → My apps & credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=        # Set AFTER registering webhook: POST /api/admin/register-webhook
PAYPAL_ENV=sandbox        # sandbox | live  (change to "live" for production)
MERCHANT_ID=              # Your internal merchant identifier

# ── Database ──────────────────────────────────────────────────────────────────
# Render injects this automatically when a PostgreSQL database is attached.
# For local dev: postgresql://user:password@localhost:5432/anchor
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Render generates API_SECRET and APPROVAL_TOKEN_SECRET automatically.
# For local dev, set strong random values:
API_SECRET=                     # Protects /api/admin/* and merchant data endpoints
APPROVAL_TOKEN_SECRET=          # Signs approval-link tokens (HMAC); survives restarts

# ── Operational mode ──────────────────────────────────────────────────────────
SHADOW_MODE=0                   # 1 = oracle runs but NO PayPal API calls are made
MERCHANT_POLICY_LOADED=0        # Set to 1 after loading your merchant policy config

# ── Oracle thresholds ─────────────────────────────────────────────────────────
AUTO_ACCEPT_BELOW=60            # Auto-accept disputes below this USD amount
AUTO_FIGHT_ABOVE=200            # Auto-fight disputes above this USD amount
AUTO_FIGHT_MIN_PROB=0.60        # Minimum win probability to auto-fight

# ── Seller profile (used in EV calculations) ─────────────────────────────────
SELLER_ACCOUNT_AGE_DAYS=730
SELLER_HOURLY_RATE=50
SELLER_WIN_RATE=0.5

# ── Webhook outbox ────────────────────────────────────────────────────────────
WEBHOOK_OUTBOX_ENABLED=1
WEBHOOK_OUTBOX_PATH=webhook_outbox.jsonl   # Only used when DATABASE_URL is unset

# ── Recovery Agent ────────────────────────────────────────────────────────────
RECOVERY_VALIDATION_ENABLED=1
RECOVERY_DELAY_MINUTES=30
RECOVERY_MIN_AMOUNT=10
RECOVERY_MAX_ATTEMPTS=2

# ── Notifications ─────────────────────────────────────────────────────────────
MERCHANT_EMAIL=
SLACK_WEBHOOK_URL=

# ── Elasticsearch (optional — superseded by PostgreSQL when DATABASE_URL is set)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# ── AI model ─────────────────────────────────────────────────────────────────
ANCHOR_AI_MODEL=claude-sonnet-4-6

# ── Astro Gateway (optional) ─────────────────────────────────────────────────
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
