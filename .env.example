PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id

ELASTICSEARCH_URL=https://your-cluster.es.io:9243
ELASTICSEARCH_API_KEY=your_elastic_api_key

# Merchant identity — used to scope guardian memory and briefs
MERCHANT_ID=your_merchant_id

# Guardian pre-authorization thresholds
# Anchor auto-accepts disputes below this amount (no approval needed)
AUTO_ACCEPT_BELOW=60
# Anchor auto-fights disputes above this amount if win probability >= AUTO_FIGHT_MIN_PROB
AUTO_FIGHT_ABOVE=200
AUTO_FIGHT_MIN_PROB=0.60

# Seller profile — used by Settlement Oracle
SELLER_ACCOUNT_AGE_DAYS=730
SELLER_WIN_RATE=0.5
SELLER_HOURLY_RATE=50

# Approval token security — HMAC secret for dispute-bound approval links
# On Render this is auto-generated. For local dev, set any long random string.
APPROVAL_TOKEN_SECRET=generate-a-random-secret-here

# Public URL of your Render deployment — used to build approval links in Slack alerts
RENDER_EXTERNAL_URL=https://anchor-paypal.onrender.com

# Recovery agent — abandoned checkout recovery
MERCHANT_EMAIL=your_paypal_merchant_email
RECOVERY_DELAY_MINUTES=30      # minutes after order approval before recovery triggers
RECOVERY_MIN_AMOUNT=10         # skip recovery for orders below this amount
RECOVERY_MAX_ATTEMPTS=2        # max recovery emails per abandoned order

# Optional integrations
SLACK_WEBHOOK_URL=your_slack_webhook_url

# APIMatic — deterministic API context plugin (prevents hallucinated PayPal endpoints)
# Get a free key at apimatic.io — regenerates PayPal API context from live OpenAPI spec
APIMATIC_API_KEY=your_apimatic_api_key

# Channel3 — product data enrichment for dispute evidence
# Free tier: 1,000 searches/month — sign up at trychannel3.com/sign-up/developer
CHANNEL3_API_KEY=your_channel3_api_key
